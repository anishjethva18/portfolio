{
  "name": "windows-portfolio-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd .. && node -r ./server/loadEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/server.ts",
    "build": "cd .. && esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=server/server.bundle.cjs",
    "start": "cd .. && node -r ./server/loadEnv.cjs server/server.bundle.cjs",
    "test": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/backend-api.test.ts",
    "test:widgets": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs --test server/tests/widgets-market-fallback.test.ts",
    "test:email": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/email-service.test.ts",
    "test:skills": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/skill-catalog.test.ts",
    "test:skill-icons": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/skill-icons-api.test.ts",
    "test:profile-visibility": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/profile-visibility.test.ts",
    "test:admin-session-lifecycle": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/admin-session-lifecycle.test.ts",
    "test:capture-persistence": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/capture-persistence.test.ts",
    "test:project-markdown": "cd .. && node --import=./server/node_modules/tsx/dist/loader.mjs --test server/tests/project-markdown-storage.test.ts",
    "test:visibility-publish": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/content-visibility-publish.test.ts",
    "test:limitations": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/comprehensive-limitations.test.ts",
    "test:e2e": "cd .. && node -r ./server/testEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/tests/e2e-walkthrough.test.ts",
    "test:all": "npm run test && npm run test:limitations && npm run test:e2e && npm run test:seo-metadata",
    "test:seo-metadata": "cd .. && node --import=./server/node_modules/tsx/dist/loader.mjs --test server/tests/seo-metadata.test.ts server/tests/portfolio-media-headers.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap:admin": "cd .. && node -r ./server/loadEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/scripts/bootstrapAdmin.ts",
    "create-admin": "cd .. && node -r ./server/loadEnv.cjs --import=./server/node_modules/tsx/dist/loader.mjs server/scripts/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.10.4",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.14",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
