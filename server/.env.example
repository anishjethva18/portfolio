# ENVIRONMENT MODE & SERVER PORT:
NODE_ENV="development"
TZ="Asia/Kolkata"
PORT="3000"
TRUST_PROXY_HOPS="0"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for CORS restrictions, self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
# Public origin used for remote images in outgoing email. If the API is hosted
# separately from the portfolio site, set this to the public API origin.
EMAIL_PUBLIC_BASE_URL=""
# Explicit additional browser origins allowed to call the production API, comma-separated.
# Do not add wildcard domains or origins you do not control.
CORS_ALLOWED_ORIGINS=""

# CONTACT EMAIL INTEGRATION:
CONTACT_RECEIVER_EMAIL="admin@portfolio.local"
EMAIL_FROM="Portfolio Contact <admin@portfolio.local>"

# EMAIL_PROVIDER is optional. Leave it unset to auto-select in this order:
# Resend API -> Gmail Google OAuth2 -> Gmail SMTP -> generic SMTP -> local mock.
# Set it to resend, gmail_oauth, gmail_smtp, or smtp to explicitly select a provider.
EMAIL_PROVIDER=""

# Resend REST API (preferred when RESEND_API_KEY is present).
RESEND_API_KEY=""
RESEND_FROM=""

# Gmail SMTP using a Google OAuth2 refresh token.
# Grant https://mail.google.com/ scope when creating the OAuth consent credentials.
GMAIL_USER=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
# GOOGLE_OAUTH_ACCESS_TOKEN="" # Optional; refresh token is preferred.

# Gmail SMTP using a Google App Password, or generic SMTP.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""

# DATABASE PERSISTENCE:
# MongoDB connection URI (e.g. mongodb://win11_app_user:password@localhost:27017/win11portfolio or MongoDB Atlas URI)
# If omitted or offline, an embedded memory database is automatically provisioned for local testing.
MONGODB_URI="mongodb://localhost:27017/portfolio"

# SECURITY & AUTHENTICATION:
# Cryptographically high-entropy JWT secrets (must be at least 32 characters in production)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Administrator bootstrap configuration (password is entered through a temporary PowerShell prompt)
# ADMIN_EMAIL="admin@portfolio.local"
# ADMIN_SETUP_TOKEN="[SECURE_SETUP_TOKEN]"

# PRIVATE STORAGE ROOTS (Optional overrides; never point these at client/public or client/dist):
# UserCapture and AdminArchive default under server/storage.
# Explicitly consented camera archives default to server/storage/Portfolio/Captures/{Photos,Videos}.
# Portfolio backups default to server/storage/AdminArchive/Backups.
USER_CAPTURE_ROOT=""
ADMIN_ARCHIVE_ROOT=""
CAPTURE_ARCHIVE_ROOT=""
PORTFOLIO_STORAGE_DIR=""
PORTFOLIO_BACKUP_DIR=""
